# Copy to .env.test (gitignored) and fill in. See tests/README.md.
# Use dedicated test accounts whose password is already set (no forced change).

TEST_BASE_URL=http://localhost:3000

TEST_SUPER_ADMIN_EMAIL=
TEST_SUPER_ADMIN_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_FACULTY_EMAIL=
TEST_FACULTY_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=

# 1 = send each run to /super-admin/tests (signs in as the super admin above)
TEST_REPORT=0
# Where to send it, if not TEST_BASE_URL
TEST_REPORT_URL=
