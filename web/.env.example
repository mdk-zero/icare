# =================================================================
# iCARE++ environment variables
# Copy this file to `.env.local` and fill in real values.
# =================================================================

# --- Google OAuth (Web application client) -----------------------------
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Google OAuth (mobile app clients, optional) ------------------------
# Only needed to accept Google sign-in from the Expo mobile app; the ID
# token's `aud` claim is the client ID that requested it, so each platform's
# client must be allow-listed here in addition to the web client above.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Supabase -----------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Session signing secret ---------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- ML service (ml/ FastAPI: at-risk prediction + recommender) ---------
# Base URL of the deployed ml/ service; secret must match its ML_SERVICE_SECRET.
# Leaving these blank is what makes the admin analytics "Run ML" button answer
# 503 "ML service is not configured".
#
# For local work, start the service from ml/ (see ml/README.md) and point at it:
#   ML_SERVICE_URL=http://127.0.0.1:8000
# A deployed web app cannot reach a local service, so production needs the
# service hosted somewhere public (ml/fly.toml and ml/Dockerfile are ready).
ML_SERVICE_URL=
ML_SERVICE_SECRET=

# --- Google Gemini (AI scenario generation) -----------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash  # optional, defaults to gemini-2.5-flash

# --- OpenRouter (fallback AI scenario generation) -----------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash-exp:free  # optional

# --- Transactional email ------------------------------------------------
# Two providers are supported. If RESEND_API_KEY is set it wins; otherwise
# the SMTP_* block below is used. Set MAIL_SEND_IN_DEV=true to send for real
# in development (otherwise messages are logged and skipped).
MAIL_FROM_NAME=iCARE++
MAIL_SEND_IN_DEV=true

# --- Option 1: Resend ---------------------------------------------------
# https://resend.com/api-keys
#
# IMPORTANT: RESEND_FROM_EMAIL must be at a domain you have verified at
# https://resend.com/domains. Until a domain is verified, Resend accepts
# only messages addressed to the email of the Resend account itself, and
# refuses everything else with 403 -- so student invitations to anyone but
# you will fail. A gmail.com address can never be verified here; the domain
# has to be one whose DNS you control.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Option 2: SMTP -----------------------------------------------------
# Example uses Gmail. Generate an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=linuxadona17@gmail.com
SMTP_FROM_NAME=iCARE++
# Legacy alias for MAIL_SEND_IN_DEV; still honoured.
SMTP_SEND_IN_DEV=true
