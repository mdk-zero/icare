# =================================================================
# iCARE++ mobile environment variables
# Copy this file to `.env` and fill in real values.
# Only EXPO_PUBLIC_* variables are exposed to the app bundle.
# =================================================================

# --- Backend API ---------------------------------------------------------
# Base URL of the icare web app (its Next.js API routes serve mobile too).
#
# Production is https://www.i-care.dev. This file only affects `expo start`
# and local dev-client builds: `.env.local` is gitignored, so EAS never sees
# it, and the value baked into an EAS build comes from the matching profile's
# `env` block in eas.json.
#
# Leave this unset to let lib/client.ts choose per platform (10.0.2.2 for the
# Android emulator, localhost elsewhere). Set your machine's LAN IP when
# testing on a physical device, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=https://www.i-care.dev

# --- Google Sign-In -------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# The web client ID is enough to test the implicit id_token flow in Expo Go;
# add its redirect URI (shown by the app / expo-auth-session at runtime) to
# that OAuth client's "Authorized redirect URIs" in Google Cloud Console.
# iOS/Android client IDs are only needed for a standalone or dev-client build
# and must be the corresponding "iOS"/"Android" client type (not "Web"), so
# they must also be added on the server as GOOGLE_IOS_CLIENT_ID /
# GOOGLE_ANDROID_CLIENT_ID (see web/.env.example) or the ID token won't verify.
#
# Both are bound to the app id — Android additionally to the signing
# certificate's SHA-1 — so they must be recreated for `dev.icare.mobile` and
# for the EAS-managed keystore (`eas credentials` prints its fingerprint).
# Until then, Google sign-in fails in an EAS build; email/password is
# unaffected.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
