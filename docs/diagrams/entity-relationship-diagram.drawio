vice_feedback__created_at"><mxGeometry x="98" y="0" width="140" height="15" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;fillColor=#ffffff;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="20" y="1777" width="2632" height="64" as="geometry"/></mxCell><mxCell id="legend_text" value="&lt;b&gt;How to read it&lt;/b&gt; &amp;nbsp; &lt;b style=&quot;color:#B45309&quot;&gt;PK&lt;/b&gt; primary key &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#1D4ED8&quot;&gt;FK&lt;/b&gt; foreign key &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#6B7280&quot;&gt;UQ&lt;/b&gt; unique &amp;nbsp;·&amp;nbsp; Lines join a foreign key to the key it references inside the same area: the forked end is the &lt;i&gt;many&lt;/i&gt; side, the bar end the &lt;i&gt;one&lt;/i&gt; side, a circle means optional.&lt;br&gt;Keys that point to another area, and every key to &lt;b style=&quot;color:#1D4ED8&quot;&gt;users&lt;/b&gt;, are written on the column as &lt;b&gt;→ table&lt;/b&gt; in that area&#x27;s colour instead of a line, so each area stays readable on its own." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#111827;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="20" y="1777" width="2632" height="64" as="geometry"/></mxCell><mxCell id="e869" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=8;endSize=8;strokeColor=#1D4ED8;strokeWidth=1;opacity=85;" edge="1" parent="1" source="r_users__campus_id" target="r_campuses__id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e870" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=8;endSize=8;strokeColor=#1D4ED8;strokeWidth=1;opacity=85;" edge="1" parent="1" source="r_users__section_id" target="r_sections__id"><mxGeometry relative="1" as="geometry"/></m