# Dependencies
node_modules/

# Build output
dist/
# Next.js writes trace output here if a build is run from the repo root
# instead of web/ (web/.gitignore's /.next/ only anchors inside web/).
.next/

# Env
.env

# Local backups (e.g. pre-SDK-upgrade copies of mobile/)
*.bak/

# Database snapshots (contain live user data — never commit)
db-backups/
